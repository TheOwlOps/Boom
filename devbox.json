{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/schemas/devbox.schema.json",
  "description": "Boom - Autonomous Agent Harness (reproducible dev environment)",
  "env": {
    "BOOM_API_PORT": "18080",
    "PYTHONPATH": "$PWD:$PWD/agent/src:$PYTHONPATH"
  },
  "name": "boom",
  "packages": [
    "python312",
    "python312Packages.pip",
    "python312Packages.httpx",
    "python312Packages.pydantic",
    "nodejs_22",
    "tesseract",
    "tesseract-lang-vie",
    "tesseract-lang-eng",
    "git",
    "curl",
    "python312Packages.pytest",
    "python312Packages.pyyaml"
  ],
  "shell": {
    "init_hook": [
      "echo '🤖 Boom dev environment ready'",
      "echo '  API:     http://127.0.0.1:18080'",
      "echo '  Desktop: cd apps/desktop && npm run dev (Tauri dev)'",
      "echo ''",
      "echo 'Run: ./start.sh all'"
    ],
    "scripts": {
      "start": "./start.sh all",
      "stop": "./stop.sh",
      "test": "python3 -m pytest evals/ -q 2>/dev/null || ls evals/test_*.py | head -5",
      "desktop_build": "cd apps/desktop && npm run build",
      "desktop_install": "cd apps/desktop && npm install"
    }
  }
}