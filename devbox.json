{"$schema":"https://raw.githubusercontent.com/jetify-com/devbox/main/schemas/devbox.schema.json","description":"Boom - Desktop (Tauri) + Mobile (Kotlin) dev environment","name":"boom","packages":["nodejs_22","git","curl","rustup"],"shell":{"init_hook":["echo '🤖 Boom dev environment ready'","echo '  Desktop: cd apps/desktop && npm install && npm run tauri dev'","echo '  Rust:    cargo check -p boom-core'"],"scripts":{"desktop_dev":"cd apps/desktop && npm run tauri dev","desktop_install":"cd apps/desktop && npm install","rust_check":"cargo check -p boom-core","rust_test":"cargo test -p boom-core"}}}