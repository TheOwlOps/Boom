{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "enables the default permissions",
  "identifier": "default",
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    {
      "allow": [
        {
          "args": true,
          "name": "../../../gateway/binaries/boom-backend",
          "sidecar": true
        }
      ],
      "identifier": "shell:allow-spawn"
    }
  ],
  "windows": [
    "main"
  ]
}
